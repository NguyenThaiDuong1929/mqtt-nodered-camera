    {
        "id": "func_esp32_mcu",
        "type": "function",
        "z": "tab_camera_light",
        "name": "ESP32 (MCU) - Kiểm tra True / false",
        "func": "// 1. Đọc payload nhận được từ topic: light\nconst payload = String(msg.payload).trim();\n\n// 2. Khối hình thoi kiểm tra điều kiện phía ESP32 (MCU)\nif (payload === \"1\") {\n    // Nhánh True -> Bật đèn Light\n    msg.condition = \"True\";\n    msg.lightStatus = \"LIGHT ON (Bật đèn)\";\n    node.status({ fill: \"green\", shape: \"dot\", text: \"True -> Light: ON\" });\n} else {\n    // Nhánh false -> Tắt đèn Light\n    msg.condition = \"false\";\n    msg.lightStatus = \"LIGHT OFF (Tắt đèn)\";\n    node.status({ fill: \"grey\", shape: \"ring\", text: \"false -> Light: OFF\" });\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 300,
        "wires": [
            [
                "debug_light"
            ]
        ]
    },

    {
        "id": "func_core_platform",
        "type": "function",
        "z": "tab_camera_light",
        "name": "CORE PLATFORM (Rẽ nhánh true:1 / false:0)",
        "func": "// 1. Nhận kết quả từ Camera IP (true hoặc false)\nconst cameraDetected = msg.payload;\n\n// 2. Chọn topic theo đúng sơ đồ: topic: light\nmsg.topic = \"light\";\n\n// 3. Khối hình thoi rẽ nhánh phía CORE PLATFORM\nif (cameraDetected === true) {\n    msg.payload = \"1\"; // Nhánh true:1\n} else {\n    msg.payload = \"0\"; // Nhánh false:0\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 130,
        "wires": [
            [
                "mqtt_out_light",
                "debug_core_publish"
            ]
        ]
    },

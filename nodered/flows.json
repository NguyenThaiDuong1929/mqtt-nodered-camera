    {
        "id": "func_esp32_mcu",
        "type": "function",
        "z": "tab_light_control",
        "name": "ESP32 (MCU) - Kiểm tra & Điều khiển Light",
        "func": "// Đọc dữ liệu nhận được từ topic: light\nconst receivedTopic = msg.topic;\nconst receivedPayload = String(msg.payload).trim();\n\n// Khối hình thoi kiểm tra phía ESP32 (MCU)\nif (receivedPayload === \"1\" || receivedPayload.toLowerCase() === \"true\") {\n    // Nhánh True -> Bật đèn\n    msg.lightState = \"ON\";\n    msg.payload = `[ESP32 - topic '${receivedTopic}'] Nhận '${receivedPayload}' (True) -> LIGHT: BẬT (ON)`;\n} else {\n    // Nhánh false -> Tắt đèn\n    msg.lightState = \"OFF\";\n    msg.payload = `[ESP32 - topic '${receivedTopic}'] Nhận '${receivedPayload}' (false) -> LIGHT: TẮT (OFF)`;\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 300,
        "wires": [
            [
                "debug_light_output"
            ]
        ]
    },

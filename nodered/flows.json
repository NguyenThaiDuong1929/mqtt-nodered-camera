    {
        "id": "func_core_platform",
        "type": "function",
        "z": "tab_light_control",
        "name": "CORE PLATFORM (Rẽ nhánh true:1 / false:0)",
        "func": "// Nhận tín hiệu từ Camera IP (true hoặc false)\nconst isDetected = msg.payload;\n\n// Đặt topic theo đúng sơ đồ: topic: light\nmsg.topic = \"light\";\n\n// Rẽ nhánh điều kiện (khối hình thoi bên CORE PLATFORM)\nif (isDetected === true) {\n    msg.payload = \"1\"; // Nhánh true:1\n} else {\n    msg.payload = \"0\"; // Nhánh false:0\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 130,
        "wires": [
            [
                "mqtt_out_light",
                "debug_core_sent"
            ]
        ]
    },
